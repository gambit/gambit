(include "#.scm")

;; Exact representable values isolate rounding and sign behavior.
(test-eqv 2.0 (fl/ 8.0 2.0 2.0))
(test-eqv 0.5 (fl/ 2.0))
(test-eqv +inf.0 (fl/ 1.0 0.0))
(test-eq #t (fl< 1.0 2.0 3.0))
(test-eq #f (fl< 1.0 2.0 2.0))
(test-eq #t (fl<= 1.0 2.0 2.0))
(test-eq #f (fl<= 1.0 2.0 1.0))
(test-eq #t (fl> 3.0 2.0 1.0))
(test-eq #f (fl> 3.0 2.0 2.0))
(test-eq #t (fl>= 3.0 2.0 2.0))
(test-eq #f (fl>= 3.0 2.0 3.0))
(test-eq #f (fl< 1.0 +nan.0))
(test-eq #f (fl<= +nan.0 1.0))
(test-eq #f (fl> +nan.0 1.0))
(test-eq #f (fl>= 1.0 +nan.0))
(test-eqv 2.0 (flabs -2.0))
(test-eqv 0.0 (flabs -0.0))
(test-eqv 9.0 (flsquare -3.0))
(test-eqv 3.0 (flsqrt 9.0))
(test-eqv -0.0 (flsqrt -0.0))
(test-eqv 0.0 (flacos 1.0))
(test-eqv 0.0 (flasin 0.0))
(test-eqv -2.0 (flfloor -1.5))
(test-eqv -1.0 (flceiling -1.5))
(test-eqv 2.0 (flround 2.5))
(test-eqv 4.0 (flround 3.5))
(test-eqv -2.0 (flround -2.5))
(test-eqv -4.0 (flround -3.5))
(test-eqv 1.0 (flexp 0.0))
(test-eqv 0.0 (flexpm1 0.0))
(test-eqv -0.0 (flexpm1 -0.0))
(test-eqv 0.0 (fllog 1.0))
(test-eqv 0.0 (fllog1p 0.0))
(test-eqv -0.0 (fllog1p -0.0))
(test-eqv 3 (flilogb 8.0))
(test-eqv -3 (flilogb 0.125))
(test-eqv 12.0 (flscalbn 1.5 3))
(test-eqv 0.375 (flscalbn 1.5 -2))
(test-eqv 42.0 (fixnum->flonum 42))
(test-error type-exception? (flabs 1))
(test-error type-exception? (flsqrt #f))
(test-error type-exception? (flsquare 1))
(test-error type-exception? (flscalbn 1.5 2.0))
(test-error type-exception? (fixnum->flonum 1.0))
